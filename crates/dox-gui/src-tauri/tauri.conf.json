{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "dox",
    "version": "0.1.0",
    "identifier": "app.dox.desktop",
    "build": {
        "beforeDevCommand": "npm run build:icons && npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build:icons && npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Dox",
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": { "x": 12, "y": 22 },
                "backgroundColor": "#ebeef0",
                "theme": "Light",
                "width": 1200,
                "height": 800,
                "minWidth": 800,
                "minHeight": 540
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'none'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app"],
        "icon": ["icons/generated/icon.icns", "icons/icon.png"],
        "category": "Productivity",
        "shortDescription": "Local, linked Typst notes"
    }
}
