{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dox",
  "version": "0.1.0",
  "identifier": "app.dox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "dox", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' blob:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420" }
  },
  "bundle": { "active": true, "targets": ["app"], "category": "Productivity", "shortDescription": "Local, linked Typst notes" }
}
