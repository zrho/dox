{
  "commands": {
    "title": "Show command panel",
    "binding": {
      "key": "p",
      "shift": true
    }
  },
  "find": {
    "title": "Find note",
    "binding": {
      "key": "p"
    }
  },
  "close": {
    "title": "Close focused pane"
  },
  "escape": {
    "title": "Dismiss or close",
    "binding": {
      "key": "escape",
      "primary": false
    }
  },
  "previous-pane": {
    "title": "Focus previous note",
    "binding": {
      "key": "j",
      "aliases": ["arrowleft"],
      "primary": false,
      "allowInTextFields": false
    }
  },
  "next-pane": {
    "title": "Focus next note",
    "binding": {
      "key": "k",
      "aliases": ["arrowright"],
      "primary": false,
      "allowInTextFields": false
    }
  },
  "move-pane-previous": {
    "title": "Move note left",
    "binding": {
      "key": "j",
      "aliases": ["arrowleft"],
      "shift": true,
      "primary": false,
      "allowInTextFields": false
    }
  },
  "move-pane-next": {
    "title": "Move note right",
    "binding": {
      "key": "k",
      "aliases": ["arrowright"],
      "shift": true,
      "primary": false,
      "allowInTextFields": false
    }
  },
  "new-note": {
    "title": "New note",
    "binding": {
      "key": "n"
    }
  },
  "daily-note": {
    "title": "Open today's note",
    "binding": {
      "key": "d",
      "shift": true
    }
  },
  "new-window": {
    "title": "New window",
    "binding": {
      "key": "n",
      "shift": true
    }
  },
  "new-literature": {
    "title": "New empty literature item"
  },
  "import-publication": {
    "title": "Import publication from link or tag"
  },
  "open-library": {
    "title": "Open library"
  },
  "attach-files": {
    "title": "Attach files to item"
  },
  "find-paper-pdf": {
    "title": "Find and attach paper PDF"
  },
  "save": {
    "title": "Save note",
    "binding": {
      "key": "s"
    }
  },
  "toggle-mode": {
    "title": "Toggle edit/view"
  },
  "edit": {
    "title": "Edit source",
    "binding": {
      "key": "e",
      "primary": false,
      "allowInTextFields": false
    }
  },
  "view": {
    "title": "View note"
  },
  "insert": {
    "title": "Insert link or citation",
    "binding": {
      "key": "k"
    }
  },
  "insert-with-title": {
    "title": "Insert link or citation with title",
    "binding": {
      "key": "k",
      "shift": true
    }
  },
  "copy": {
    "title": "Copy note link or citation"
  },
  "toggle-sidebar": {
    "title": "Toggle sidebar",
    "binding": {
      "key": "b"
    }
  },
  "zoom-in": {
    "title": "Zoom in content",
    "binding": {
      "key": "="
    }
  },
  "zoom-out": {
    "title": "Zoom out content",
    "binding": {
      "key": "-"
    }
  },
  "zoom-reset": {
    "title": "Reset content zoom",
    "binding": {
      "key": "0"
    }
  },
  "toggle-pin": {
    "title": "Toggle pin"
  },
  "delete": {
    "title": "Delete note",
    "binding": {
      "key": "d",
      "primary": false,
      "allowInTextFields": false
    }
  },
  "undo-delete": {
    "title": "Undo last note deletion"
  }
}
