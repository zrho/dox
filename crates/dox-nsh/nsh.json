      "dark": {
        "background": "#10141c",
        "foreground": "#bfbdb6",
        "card": "#141821",
        "popover": "#0f131a",
        "muted": "#0d1017",
        "muted-foreground": "#8a96a8",
        "border": "#292f3a",
        "primary": "#e6b450",
        "primary-foreground": "#241b0d",
        "accent": "#232b38",
