{
  "name": "dox NSH",
  "id": "app.dox.nsh",
  "version": "0.1.0",
  "build": 1,
  "icon": "icon.png",
  "rust": ".",
  "appearance": "system",
  "theme": {
    "cssVars": {
      "theme": {
        "card-foreground": "var(--foreground)",
